# Ambiente: development, test ou production
NODE_ENV=development
HOST=0.0.0.0
PORT=3000

# URL externa do ComDoc. Em produção, use HTTPS.
COMDOC_PUBLIC_URL=http://localhost:3000

# Obrigatório em produção, com pelo menos 32 caracteres aleatórios.
COMDOC_SESSION_SECRET=substitua-por-um-segredo-longo-e-aleatorio

# Em produção atrás de proxy reverso, mantenha ambos como true.
COMDOC_TRUST_PROXY=false
COMDOC_FORCE_HTTPS=false

# Volume persistente. Quando preenchido, agrupa banco, uploads, PDFs e backups.
# COMDOC_DATA_DIR=C:/dados/comdoc

# Caminhos opcionais para sobrescrever partes específicas.
# COMDOC_DATABASE_PATH=C:/dados/comdoc/database/comdoc.db
# COMDOC_UPLOADS_DIR=C:/dados/comdoc/uploads
# COMDOC_OUTPUT_DIR=C:/dados/comdoc/output
# COMDOC_BACKUP_DIR=C:/dados/comdoc/backups

COMDOC_BACKUP_RETENTION_DAYS=30
COMDOC_JSON_LIMIT=1mb
COMDOC_LOGIN_RATE_WINDOW_MIN=15
COMDOC_LOGIN_RATE_MAX_PER_IP=3
COMDOC_SHUTDOWN_TIMEOUT_SECONDS=15
COMDOC_LOG_LEVEL=debug
