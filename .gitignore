# Dependências
node_modules/

# Banco de dados local
database/*.db
database/*.db-shm
database/*.db-wal

# PDFs e arquivos gerados
output/*
!output/.gitkeep

# Imagens enviadas pelos usuários
src/uploads/produtos/*
!src/uploads/produtos/.gitkeep
src/uploads/empresas/*

# Dados persistentes quando COMDOC_DATA_DIR aponta para a pasta do projeto
data/
backups/

# Logs
*.log
npm-debug.log*

# Arquivos temporários e backups
*.bak
*.tmp
*.temp

# Variáveis de ambiente
.env
.env.local

# Sistema operacional
.DS_Store
Thumbs.db

# Editores
.vscode/
.idea/
